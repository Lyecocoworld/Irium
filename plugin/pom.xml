<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.irium</groupId>
    <artifactId>irium</artifactId>
    <version>0.3.0</version>
    <packaging>jar</packaging>
    <name>Irium</name>
    <description>Irium — the rare element of modding. J1: consent dialog + hello channel.</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Provided by the server at runtime — NEVER shade/relocate Adventure -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>26.1.2.build.74-stable</version>
            <scope>provided</scope>
        </dependency>
        <!-- NMS mojang-mappé du serveur de test Canvas 26.2 (build 827) -->
        <dependency>
            <groupId>net.minecraft</groupId>
            <artifactId>canvas-server</artifactId>
            <version>26.2</version>
            <scope>system</scope>
            <systemPath>C:/Users/space/irium-test/server/versions/26.2/canvas-26.2.jar</systemPath>
        </dependency>
        <!-- Netty du serveur (RegistryFriendlyByteBuf étend ByteBuf) -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-buffer</artifactId>
            <version>4.2.15.Final</version>
            <scope>system</scope>
            <systemPath>C:/Users/space/irium-test/server/libraries/io/netty/netty-buffer/4.2.15.Final/netty-buffer-4.2.15.Final.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-common</artifactId>
            <version>4.2.15.Final</version>
            <scope>system</scope>
            <systemPath>C:/Users/space/irium-test/server/libraries/io/netty/netty-common/4.2.15.Final/netty-common-4.2.15.Final.jar</systemPath>
        </dependency>
        <!-- Datafixers (Pair, référencé par les signatures NMS) -->
        <dependency>
            <groupId>com.mojang</groupId>
            <artifactId>datafixerupper</artifactId>
            <version>10.0.21</version>
            <scope>system</scope>
            <systemPath>C:/Users/space/irium-test/server/libraries/com/mojang/datafixerupper/10.0.21/datafixerupper-10.0.21.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.mojang</groupId>
            <artifactId>authlib</artifactId>
            <version>9.0.75</version>
            <scope>system</scope>
            <systemPath>C:/Users/space/irium-test/server/libraries/com/mojang/authlib/9.0.75/authlib-9.0.75.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport</artifactId>
            <version>4.2.15.Final</version>
            <scope>system</scope>
            <systemPath>C:/Users/space/irium-test/server/libraries/io/netty/netty-transport/4.2.15.Final/netty-transport-4.2.15.Final.jar</systemPath>
        </dependency>
        <!-- ASM pour les patches bytecode à la définition (shadé en dev.irium.shaded.asm)
             9.9.1 = support class file major 69 (Java 25, requis par le mod SVC) -->
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
            <version>9.9.1</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>Irium-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <relocations>
                                <relocation>
                                    <pattern>org.objectweb.asm</pattern>
                                    <shadedPattern>dev.irium.shaded.asm</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>org.ow2.asm:*</artifact>
                                    <excludes><exclude>META-INF/**</exclude></excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
