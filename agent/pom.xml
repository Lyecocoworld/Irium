<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-schema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>dev.irium</groupId>
  <artifactId>irium-agent</artifactId>
  <version>0.6.22</version>
  <packaging>jar</packaging>
  <name>Irium Agent</name>

  <dependencies>
    <!-- ASM : bytecode weaving du pipeline netty (relocalisé dans l'agent final) -->
    <dependency>
      <groupId>org.ow2.asm</groupId>
      <artifactId>asm</artifactId>
      <version>9.9.1</version>
    </dependency>
    <dependency>
      <groupId>org.ow2.asm</groupId>
      <artifactId>asm-tree</artifactId>
      <version>9.9.1</version>
    </dependency>
    <dependency>
      <groupId>org.ow2.asm</groupId>
      <artifactId>asm-commons</artifactId>
      <version>9.9.1</version>
    </dependency>
    <dependency>
      <groupId>org.ow2.asm</groupId>
      <artifactId>asm-util</artifactId>
      <version>9.9.1</version>
    </dependency>
    <!-- Mixin officiel Fabric (service custom Irium via ServiceLoader) -->
    <dependency>
      <groupId>net.fabricmc</groupId>
      <artifactId>sponge-mixin</artifactId>
      <version>0.16.2-mixin.0.8.7</version>
    </dependency>
    <!-- Gson : shadé dans l'agent pour parser fabric.mod.json côté client (fourni par le
         classpath du jeu, mais on ne dépend pas de sa présence au compile) -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.11.0</version>
    </dependency>
    <!-- M7-B9 : MixinExtras — sur vraie Fabric le LOADER le fournit (0.15+) ; nous
         on EST le loader -> bundlé dans l'agent (non relocalisé : les mixins des mods
         référencent com/llamalad7/... en dur). Seul -common est requis (le mod
         platform-fabric ne fait qu'appeler Bootstrap.init, on le fait nous-mêmes). -->
    <dependency>
      <groupId>io.github.llamalad7</groupId>
      <artifactId>mixinextras-common</artifactId>
      <version>0.5.4</version>
    </dependency>
    <!-- Client MC 26.2 (SKL, Mojang-mappé) : system-scope, compile-only, JAMAIS shadé -->
    <dependency>
      <groupId>net.minecraft</groupId>
      <artifactId>client-26.2</artifactId>
      <version>26.2</version>
      <scope>system</scope>
      <systemPath>C:/Users/space/AppData/Roaming/.sklauncher/versions/26.2/26.2.jar</systemPath>
    </dependency>
    <!-- Netty : compile-only, fourni par le host à l'exécution (jamais shadé) -->
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-transport</artifactId>
      <version>4.2.15.Final</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.mojang</groupId>
      <artifactId>brigadier</artifactId>
      <version>1.3.10</version>
      <scope>system</scope>
      <systemPath>C:\Users\space\AppData\Roaming\.sklauncher\libraries\com\mojang\brigadier\1.3.10\brigadier-1.3.10.jar</systemPath>
    </dependency>
  </dependencies>

  <properties>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <relocations>
                <!-- M7-B11 : ASM NON relocalisé (retour arrière). MixinExtras — fourni
                     par l'agent, NON relocalisé car les mixins des mods référencent
                     com.llamalad7 en dur — parse le bytecode avec org.objectweb.asm BRUT
                     au PreApply. Relocaliser ASM -> NoClassDefFoundError -> tous les
                     mixins MixinExtras meurent (Xaero). Le client vanilla 26.2
                     n'embarque AUCUN ASM (vérifié) -> aucun conflit possible. -->
                <!-- PIÈGE M7-B4 : NE PAS relocaliser org.spongepowered ! Les classes mixin
                     des mods externes portent l'annotation Lorg/spongepowered/asm/mixin/Mixin;
                     (descriptor ORIGINAL). Un runtime relocalisé cherche son propre descriptor
                     -> "missing @Mixin annotation" -> aucun mixin jamais appliqué. -->
              </relocations>
              <filters>
                <!-- services originaux exclus : on déclare NOTRE service Irium (interfaces relocalisées) -->
                <filter>
                  <artifact>net.fabricmc:sponge-mixin</artifact>
                  <excludes>
                    <exclude>META-INF/services/**</exclude>
                    <exclude>org/spongepowered/tools/**</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifestEntries>
              <Premain-Class>dev.irium.agent.IriumAgent</Premain-Class>
              <Agent-Class>dev.irium.agent.IriumAgent</Agent-Class>
              <Can-Redefine-Classes>true</Can-Redefine-Classes>
              <Can-Retransform-Classes>true</Can-Retransform-Classes>
              <Irium-Version>0.6.22</Irium-Version>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
